#
# D-Bus activation for the backend. Compare xdg-desktop-portal-gtk's
# data/org.freedesktop.impl.portal.desktop.gtk.service.in, which is this file
# with the accepted names in it.
#
# Unlike the frontend's bus name, this one is NOT contested: every backend has
# its own, and several may be installed at once. That is the point of the
# naming convention - org.freedesktop.impl.portal.desktop.<backend> - and it is
# why a second backend (a Qt one, a system-browser one, a paste-only one) is a
# packaging decision here rather than a code change anywhere.
#
# At acceptance this file survives almost unchanged: only the name does, becoming
# org.freedesktop.impl.portal.desktop.<backend>. See docs/UPSTREAMING.md.

[D-BUS Service]
Name=io.github.sjtrotter.impl.portal.desktop.gtk
Exec=@libexecdir@/webauth-portal-gtk
SystemdService=webauth-portal-gtk.service
