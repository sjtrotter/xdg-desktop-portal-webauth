#
# D-Bus activation for the INCUBATING portal frontend.
#
# The shape is xdg-desktop-portal's own service file, verbatim in structure:
# https://github.com/flatpak/xdg-desktop-portal/blob/main/desktop-portal/org.freedesktop.portal.Desktop.service.in
#
#   [D-BUS Service]
#   Name=org.freedesktop.portal.Desktop
#   Exec=@libexecdir@/xdg-desktop-portal
#   SystemdService=xdg-desktop-portal.service
#
# Name below is the incubating stand-in for org.freedesktop.portal.Desktop. At
# acceptance this file is DELETED: the interface moves into xdg-desktop-portal,
# which already owns that name and already ships this file.
#
# COORDINATION WARNING. This bus name is a singleton, and the sibling
# smartcard-portal sketch would claim the same incubating name for its own
# frontend. Two incubating frontends cannot both be installed: the second to
# start fails to acquire the name. That is not a packaging accident, it is the
# design telling the truth - the real xdg-desktop-portal hosts ALL portal
# interfaces in ONE process, and so must its stand-in. See
# docs/decisions/0008-build-to-the-upstream-shape.md, "The Desktop bus name".

[D-BUS Service]
Name=io.github.sjtrotter.portal.Desktop
Exec=@libexecdir@/webauth-portal-frontend
SystemdService=webauth-portal-frontend.service
