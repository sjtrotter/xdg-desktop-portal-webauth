<?xml version="1.0"?>
<!--
 Copyright (C) 2026 the webauth-service authors

 SPDX-License-Identifier: GPL-2.0-or-later

 INCUBATING INTERFACE, version 1. This is a project-controlled reverse-DNS name.
 It is deliberately NOT in the org.freedesktop.portal.* namespace: that namespace
 belongs to xdg-desktop-portal, and using it would imply an acceptance that does
 not exist. If this interface is ever accepted upstream, the public contract moves
 there and this name is retired. See docs/SERVICE-INTERFACE.md, docs/ROADMAP.md
 and docs/decisions/0005-service-shape.md.

 The transaction pattern below is copied closely from
 org.freedesktop.portal.Request, because that pattern is correct and callers
 already know it. Copying the pattern is not the same as claiming the namespace.
-->
<node name="/" xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">

  <!--
      io.github.sjtrotter.WebAuthentication1:
      @short_description: One interactive web authentication transaction

      Performs one interactive web authentication transaction and returns an
      uninterpreted completion artifact.

      The caller supplies a URI to open and the exact URI whose navigation ends
      the transaction. The service opens the start URI in a web view it owns,
      presents security chrome the caller cannot influence, answers TLS client
      certificate challenges (including PKCS#11 tokens that require a PIN),
      watches every top level navigation, and completes the transaction on the
      first navigation whose URI matches the completion URI. The web view is
      closed before that navigation is loaded, so the completion page is never
      fetched and never rendered.

      The service does not interpret the URI it returns. It has no knowledge of
      OAuth, OpenID Connect or SAML, exchanges nothing, and stores no
      credentials. Callers implement their protocol on top.

      A TLS client certificate challenge is satisfied through an internal
      adapter with two implementations: the smart card service
      (io.github.sjtrotter.Smartcard1) where it is available and proven, and an
      in-process chooser and PIN prompt otherwise. Which one ran is not visible
      through this interface. When neither can run, the challenge is declined
      and the transaction ends with response 2 and reason
      "no_certificate_adapter".

      Version 1 supports navigation (GET) completions only. A response that
      arrives as an HTTP POST body - OpenID Connect response_mode=form_post, or
      SAML HTTP-POST binding - is NOT supported and cannot be represented as a
      completion URI. Supporting it would need a separately reviewed result of
      the shape { method, uri, content_type, body_fd }; squeezing a form body
      into a synthetic URI is not an acceptable substitute.

      Object path: /io/github/sjtrotter/WebAuthentication1
  -->
  <interface name="io.github.sjtrotter.WebAuthentication1">

    <!--
        Start:
        @parent_window: Identifier for the calling application's window, in the
          xdg-desktop-portal window identifier format ("x11:<xid>",
          "wayland:<exported handle>"). May be empty. An invalid or expired
          identifier degrades to an unparented window; it never aborts the
          transaction.
        @start_uri: The URI to open. Must be an absolute https URI with a host.
        @completion_uri: The URI whose navigation ends the transaction. Matched
          exactly on the parsed URI; see "Completion matching" in
          docs/SERVICE-INTERFACE.md. Query and fragment carry the result and
          take no part in matching.
        @options: Vardict with optional further information
        @request_handle: Object path of the
          io.github.sjtrotter.WebAuthentication1.Request object for this call

        Supported keys in the @options vardict:
        <variablelist>
          <varlistentry>
            <term>handle_token s</term>
            <listitem><para>
              A caller-chosen unguessable token used as the last element of
              @request_handle, so the caller can subscribe to ::Response before
              calling Start and avoid the response race.
            </para></listitem>
          </varlistentry>
          <varlistentry>
            <term>activation_token s</term>
            <listitem><para>
              An XDG activation token authorizing the window to take focus.
              Parenting and activation are related but not interchangeable: a
              background caller without a valid activation token does not
              silently steal focus.
            </para></listitem>
          </varlistentry>
          <varlistentry>
            <term>session_mode s</term>
            <listitem><para>
              "shared" (default) or "ephemeral". "shared" means shared among
              this service's transactions - NOT with Firefox, Chrome or the
              user's default browser. "ephemeral" runs the transaction in a
              website data store created for it and destroyed with it. A caller
              may request ephemeral; it may never defeat a policy that forces
              ephemeral. There is no per-application mode in version 1.
            </para></listitem>
          </varlistentry>
          <varlistentry>
            <term>timeout u</term>
            <listitem><para>
              Seconds before the service abandons the transaction. A caller may
              only shorten the default of 300; the hard ceiling is 900. Smart
              card and MFA flows make short fixed timeouts hostile.
            </para></listitem>
          </varlistentry>
          <varlistentry>
            <term>title s</term>
            <listitem><para>
              A purpose hint, shown beneath the service's own security chrome
              and never as the window's trusted identity. It is caller-supplied
              text and is treated as such: a caller cannot label itself
              "Microsoft Login".
            </para></listitem>
          </varlistentry>
        </variablelist>

        Unknown option keys are ignored so options can be added without a
        version bump. Unknown VALUES for a known key are an error: silently
        falling back from "ephemeral" to "shared" would be a security decision
        made by a typo.

        The result is delivered through
        io.github.sjtrotter.WebAuthentication1.Request::Response with these
        keys:
        <variablelist>
          <varlistentry>
            <term>completion_uri s</term>
            <listitem><para>
              The matched URI, complete and undecoded, exactly as the web view
              was asked to navigate to it, including query and fragment.
              Obtained from the engine rather than reconstructed. Present only
              when @response is 0.
            </para></listitem>
          </varlistentry>
          <varlistentry>
            <term>reason s</term>
            <listitem><para>
              Optional stable symbol explaining a non-zero @response. A
              diagnostic only.
            </para></listitem>
          </varlistentry>
        </variablelist>

        @response values follow the portal convention:
        0 the transaction completed and @results carries "completion_uri",
        1 the user cancelled, or the caller called Close(),
        2 the transaction ended some other way - timeout expired, no web engine
        available, no display, malformed request, the browser session
        terminated, or a client certificate was required and no certificate
        adapter could run.

        A response of 1 or 2 may carry an optional "reason s" key: a stable
        symbol such as "timeout", "no_display", "session_terminated" or
        "no_certificate_adapter". It is a diagnostic, never a
        substitute for the response code, and a consumer must tolerate its
        absence.
    -->
    <method name="Start">
      <arg type="s" name="parent_window" direction="in"/>
      <arg type="s" name="start_uri" direction="in"/>
      <arg type="s" name="completion_uri" direction="in"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="o" name="request_handle" direction="out"/>
    </method>

    <!--
        version:

        The version of this interface that is implemented. 1.
    -->
    <property name="version" type="u" access="read"/>
  </interface>

  <!--
      io.github.sjtrotter.WebAuthentication1.Request:
      @short_description: A pending transaction

      The same shape as org.freedesktop.portal.Request, under this project's own
      name. There is deliberately no separate Cancel method: Close() is the
      cancellation mechanism, exactly as in the portal pattern.

      Object path:
      /io/github/sjtrotter/WebAuthentication1/request/<sender>/<handle_token>
  -->
  <interface name="io.github.sjtrotter.WebAuthentication1.Request">

    <!--
        Close:

        Cancels the transaction. The service closes the web view and every
        dialog belonging to the transaction, and emits ::Response with
        @response 1 if it has not already responded. Close() never produces a
        later success response. Closing an already answered request is not an
        error and does nothing: a caller that times out locally at the moment
        the user finishes must not get an error and must not get two responses.

        A completion that has already been committed atomically wins over a
        simultaneous Close(); every other late event is discarded.
    -->
    <method name="Close"/>

    <!--
        Response:
        @response: 0 completed, 1 cancelled, 2 ended some other way
        @results: Vardict, carrying "completion_uri s" when @response is 0

        Emitted exactly once per transaction. After it is emitted the request
        object is no longer valid and the service has forgotten the
        transaction. The result is bound to the D-Bus connection that called
        Start: if that connection goes away the transaction is cancelled and no
        result is delivered to anyone else.
    -->
    <signal name="Response">
      <arg type="u" name="response"/>
      <arg type="a{sv}" name="results"/>
    </signal>
  </interface>
</node>
