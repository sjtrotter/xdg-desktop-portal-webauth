# SPDX-License-Identifier: LGPL-2.1-or-later
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C: tabs for indentation, 100 columns, matching the FreeRDP and Remmina code
# this project draws from.
[*.{c,h}]
indent_style = tab
indent_size = 4
max_line_length = 100

[meson.build]
indent_style = space
indent_size = 2

[*.{md,xml}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
