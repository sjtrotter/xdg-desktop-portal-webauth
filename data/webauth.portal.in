#
# The frontend needs experimental/integration and the WebAuthentication1 opt-in to expose this interface.
# UseIn provides legacy desktop selection; portals.conf takes precedence.

[portal]
DBusName=org.freedesktop.impl.portal.desktop.webauth
Interfaces=org.freedesktop.impl.portal.experimental.WebAuthentication1;
UseIn=gnome;KDE;X-Cinnamon;MATE;XFCE;
